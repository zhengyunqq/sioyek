# Sioyek User Preferences for LaTeX Bidirectional Jump & Smart Jump
inverse_search_command "/usr/local/bin/code" -r -g "%1":%2

# Command + Left Click: 智能跳转到目标页面 (Smart Jump, 模拟 Middle Click)
control_click_command smart_jump_under_cursor
command_click_command smart_jump_under_cursor

# Command + Shift + Left Click: LaTeX 反向跳转回 VS Code (SyncTeX)
control_shift_click_command synctex_under_cursor
command_shift_click_command synctex_under_cursor

# Shift + Left Click: 原生 Overview 浮动预览（与 Markdown 完全解耦，不再冲突）
shift_click_command overview_under_cursor

# Option + Left Click (⌥ + 左键单击): 点击 Markdown 便签/卡片弹出大窗阅读与编辑
new_command _md_click_handler /Users/yunzheng/anaconda3/bin/python -m sioyek.md_click_handler "%{sioyek_path}" "%{local_database}" "%{shared_database}" "%{file_path}" "%{mouse_pos_document}"
alt_click_command _md_click_handler

# Shift + Right Click 作为备选 SyncTeX
shift_right_click_command synctex_under_cursor

# Overview 预览窗口置于右上角轻量卡片（尺寸放大40%）
overview_offset 0.43 0.57
overview_size 0.53 0.39

# 状态栏显示当前最近的 Portal 及其目标位置
show_close_portal_in_statusbar 1

# ========== Python 扩展插件 (sioyek-python-extensions) ==========
# 1. 划词翻译：选中文本后调用欧路词典 (Eudic) 查词/翻译
new_command _translate /bin/bash /Users/yunzheng/.config/sioyek/eudic_lookup.sh "%{selected_text}"
# 备用：Google 翻译浮窗（通过 : 命令面板运行 _translate_google）
new_command _translate_google /Users/yunzheng/anaconda3/bin/python -m sioyek.translate "%{sioyek_path}" "%{selected_text}"

# 2. 论文下载：自动从 Google Scholar / Sci-Hub 检索并下载论文并在 Sioyek 打开
new_command _download_paper /Users/yunzheng/anaconda3/bin/python -m sioyek.paper_downloader download "%{sioyek_path}" "%{paper_name}" "%{selected_text}"

# 3. 复制 BibTeX：一键从后台抓取该论文的 BibTeX 引用格式到剪贴板
new_command _copy_bibtex /Users/yunzheng/anaconda3/bin/python -m sioyek.paper_downloader copy download "%{sioyek_path}" "%{paper_name}"

# 4. 双栏对照阅读：生成双栏对称阅读副本，对照图表与正文
new_command _dual_panelify /Users/yunzheng/anaconda3/bin/python -m sioyek.dual_panelify "%{sioyek_path}" "%{file_path}"

# 5. 内嵌注释到 PDF：将 Sioyek 中的高亮与书签直接写入 PDF 文件本体（其他阅读器可见）
new_command _embed_annotations /Users/yunzheng/anaconda3/bin/python -m sioyek.embed_annotations "%{sioyek_path}" "%{local_database}" "%{shared_database}" "%{file_path}"

# 6. 提取高亮笔记：将当前 PDF 中所有高亮过的段落汇集成一份纯高亮摘录新 PDF
new_command _extract_highlights /Users/yunzheng/anaconda3/bin/python -m sioyek.extract_highlights "%{sioyek_path}" "%{local_database}" "%{shared_database}" "%{file_path}" %{zoom_level}

# 7. 添加文本注释 (FreeText)：在 PDF 选定矩形区域内添加文字注释并直接写入 PDF
new_command _add_text /Users/yunzheng/anaconda3/bin/python -m sioyek.add_text "%{sioyek_path}" "%{local_database}" "%{shared_database}" "%{file_path}" "%{selected_rect}" "%{command_text}"
new_command _add_red_text /Users/yunzheng/anaconda3/bin/python -m sioyek.add_text "%{sioyek_path}" "%{local_database}" "%{shared_database}" "%{file_path}" "%{selected_rect}" "%{command_text}" fontsize=12 text_color=255,0,0

# 8. 删除文本注释：框选或点击目标文本注释进行删除；或者直接撤销上一条文本
new_command _delete_text /Users/yunzheng/anaconda3/bin/python -m sioyek.delete_text "%{sioyek_path}" "%{local_database}" "%{shared_database}" "%{file_path}" "%{selected_rect}"
new_command _delete_last_text /Users/yunzheng/anaconda3/bin/python -m sioyek.delete_text "%{sioyek_path}" "%{local_database}" "%{shared_database}" "%{file_path}" last %{page_number}

# 9. Markdown 卡片批注：支持富文本排版、代码块与 LaTeX 数学公式渲染；支持二次编辑与删除
new_command _add_markdown /Users/yunzheng/anaconda3/bin/python -m sioyek.add_markdown "%{sioyek_path}" "%{local_database}" "%{shared_database}" "%{file_path}" "%{selected_rect}"


